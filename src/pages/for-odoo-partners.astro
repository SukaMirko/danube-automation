---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import Faq from "../components/Faq.astro";

const faq = [
  { q: "Do you contact our clients?", a: "No. We talk to you, or to your client only when you invite us to a call. Our name doesn't appear in code, commits or documents unless you want it to." },
  { q: "How do you bill?", a: "Fixed price per module or integration, or a monthly block of hours for ongoing capacity. Invoiced in EUR or USD." },
  { q: "Which Odoo versions?", a: "Odoo 19 Community is our daily work, and we migrate modules from older versions. Enterprise projects are fine when the module itself doesn't depend on Enterprise code you can't share with us." },
  { q: "Can we start with a small test task?", a: "Yes, and we recommend it. Pick a module from your backlog, we quote it, and you judge the code before anything bigger." },
];
---

<Base
  title="White-Label Odoo Development for Odoo Partners"
  description="White-label Odoo module development, integrations and upgrades for Odoo partners. We work in your repository under your brand, on Central European Time."
>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span>For Odoo partners</span></nav>
      <p class="kicker">White-label development</p>
      <h1>Extra Odoo developers, under your brand</h1>
      <p class="lead">You sell the project and own the client. We write the modules, integrations and upgrades in your repository, to your standards, and hand them back tested.</p>
      <div class="hero-actions"><a class="btn" href="#contact">Send us a task to quote</a></div>
    </div>
  </section>

  <section class="wrap section">
    <div class="include-grid">
      <div class="include"><h3>Custom modules</h3><p>Python, OWL and QWeb, built on Odoo's inheritance so upgrades stay predictable. Tests included.</p></div>
      <div class="include"><h3>Integrations</h3><p>Shopify, couriers, banks, e-invoicing, REST and SOAP APIs, printers and scales.</p></div>
      <div class="include"><h3>Version upgrades</h3><p>Moving custom modules to Odoo 19, with a list of what changed and what your client should test.</p></div>
      <div class="include"><h3>AI features</h3><p>Order intake from messages and email, document reading, MCP agents over Odoo data.</p></div>
      <div class="include"><h3>How we work with you</h3><p>Your Git, your tickets, your code review. Daily commits, written handover notes.</p></div>
      <div class="include"><h3>Time zone</h3><p>Central European Time. A European partner gets the same working day, a US partner gets work done overnight.</p></div>
    </div>
  </section>

  <Faq items={faq} />
  <ContactForm title="Send us one task from your backlog" intro="Describe the module or integration, the Odoo version and your deadline. We reply with questions or a fixed quote within two working days." />
</Base>
